{
  "appId": "app.meetaaron.mobile",
  "appName": "Meet Aaron",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://meetaaron.app/app/campaigns",
    "hostname": "meetaaron.app",
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": false
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "backgroundColor": "#0D0F20"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0D0F20",
      "showSpinner": false
    }
  },
  "android": {
    "backgroundColor": "#0D0F20",
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "force",
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/browser",
      "@capacitor/splash-screen",
      "@capacitor/status-bar"
    ]
  }
}
