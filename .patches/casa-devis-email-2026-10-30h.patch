+  // de campagne avant la sortie des applis natives, donc personne à qui il
+  // manquerait. makeQR est protégé par `if (el)` : l'appel reste sans effet
+  // et sert de point de remontage si l'accès web devait revenir.
   makeQR("qr-pwa", "pwa");
   makeQR("qr-ios", "ios");
   makeQR("qr-android", "android");
