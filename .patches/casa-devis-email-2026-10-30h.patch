-      <p class="mobile-web-desc" data-i18n-html="c2.note">Fonctionne dès maintenant sur <b>iOS</b> et <b>Android</b>, sans passer par un store.</p>
-    </div>
-  </div>
 </main>
 
 <section class="page-section" id="tarifs">
@@ -904,6 +880,10 @@ function applyLocale(loc){
     const el = document.getElementById(elId);
     if (el) el.innerHTML = QR_SVG[key];
