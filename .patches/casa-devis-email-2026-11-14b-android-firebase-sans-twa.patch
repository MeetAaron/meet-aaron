index 24a103c..0000000
--- a/android/app/build.gradle
+++ /dev/null
@@ -1,87 +0,0 @@
-// Coque Android de Meet Aaron : une Trusted Web Activity (TWA).
-//
-// Pourquoi une TWA et pas une WebView : la TWA ouvre le site dans le VRAI
-// Chrome de l'appareil (onglet personnalisé plein écran, sans barre d'adresse
-// une fois le domaine vérifié). Conséquences qui comptent pour Aaron :
-//   - Google OAuth fonctionne (Google refuse les WebView, pas Chrome) ;
-//   - le service worker, les notifications push et le cache sont ceux du site,
-//     partagés avec Chrome — rien à réimplémenter en natif ;
-//   - une mise à jour du site = une mise à jour de l'app, sans passer par le Play Store.
-//
-// Signature :
-//   - debug   : app/debug.keystore, commité, identifiants « android/android »
-//               (les identifiants universels de débogage Android — ce n'est
-//               pas un secret). Sert UNIQUEMENT aux APK de test installés à
-//               la main. Son empreinte SHA-256 est dans README.md.
-//   - release : clé d'upload d'Alex, JAMAIS dans le dépôt. Fournie au build
-//               GitHub Actions par les secrets ANDROID_KEYSTORE_BASE64,
-//               ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD.
-
-plugins {
-    id 'com.android.application'
-}
-
-android {
-    // Identifiant DÉFINITIF (07/11/2026, avant toute publication) : le même
-    // sur Android et iOS. « twa » était un terme technique Android qui n'avait
-    // rien à faire dans un identifiant iOS ; il devient immuable au premier
-    // envoi sur un store, c'était le dernier moment pour le changer.
-    namespace 'app.meetaaron.mobile'
-    // API 36 (Android 16) : exigé par Google Play pour toute nouvelle appli
-    // depuis le 31/08/2026.
-    compileSdk 36
-
-    defaultConfig {
-        applicationId 'app.meetaaron.mobile'
-        // minSdk 24 (11/11/2026) : la « protection automatique » de Google Play
-        // refuse les app bundles en dessous d'Android 7.0 (API 24). Perte
-        // d'audience négligeable (Android 6 et moins, < 1 % du parc).
-        minSdk 24
-        targetSdk 36
-        versionCode 1
-        versionName '1.0.0'
-    }
-
-    signingConfigs {
-        debug {
-            storeFile file('debug.keystore')
-            storePassword 'android'
-            keyAlias 'androiddebugkey'
-            keyPassword 'android'
-        }
-        release {
-            // Renseignés par le workflow GitHub Actions à partir des secrets ;
-            // absents en local → le build release n'est pas signé (normal).
-            def ksPath = System.getenv('ANDROID_KEYSTORE_PATH')
-            if (ksPath) {
-                storeFile file(ksPath)
-                storePassword System.getenv('ANDROID_KEYSTORE_PASSWORD')
-                keyAlias System.getenv('ANDROID_KEY_ALIAS')
-                keyPassword System.getenv('ANDROID_KEY_PASSWORD')
-            }
-        }
-    }
-
-    buildTypes {
-        debug {
-            signingConfig signingConfigs.debug
-            applicationIdSuffix ''
-        }
-        release {
-            minifyEnabled false
-            signingConfig signingConfigs.release
-        }
-    }
-
-    compileOptions {
-        sourceCompatibility JavaVersion.VERSION_17
-        targetCompatibility JavaVersion.VERSION_17
-    }
-}
-
-dependencies {
-    // Bibliothèque officielle Google pour les TWA (LauncherActivity,
-    // DelegationService pour les notifications, repli WebView si aucun
-    // navigateur compatible n'est installé).
-    implementation 'com.google.androidbrowserhelper:androidbrowserhelper:2.7.3'
-}
