+      {!loading && campaigns.length > 0 && (() => {
+        const hasContacts = campaigns.some((c) => (c.contacts_found || 0) > 0);
+        const hasPast = campaigns.some((c) => c.status === 'terminee');
+        if (!hasContacts && !hasPast) return null;
+        return (
+          <div className="global-advice-row">
