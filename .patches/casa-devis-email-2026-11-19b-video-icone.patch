From 56428fda00923c6d3cd04ed3da829e852855be84 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 05:08:25 +0000
Subject: [PATCH] Site : retrait de la mention 'sans son' sous la video, icone
 plein cadre pour Google

La video a du son : la ligne 'Sans son, tout est ecrit a l'ecran' est
retiree de l'accueil et de la page demo (7 langues). Icone des moteurs de
recherche : fond plein jusqu'aux bords (favicon.ico et favicon-192.png),
logo centre dans la zone qui survit a un recadrage en rond. icon.png reste
l'icone de l'application.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FAruUpwVVmdAo2zCN9Cguf
---
 app/layout.jsx         |   9 ++++++++-
 public/demo.html       |   1 -
 public/favicon-192.png | Bin 0 -> 8706 bytes
 public/favicon.ico     | Bin 29173 -> 25539 bytes
 public/landing.html    |  10 +---------
 5 files changed, 9 insertions(+), 11 deletions(-)
 create mode 100644 public/favicon-192.png

diff --git a/app/layout.jsx b/app/layout.jsx
index e1e19dc..635a6e2 100644
--- a/app/layout.jsx
+++ b/app/layout.jsx
@@ -37,7 +37,14 @@ export const metadata = {
     icons: {
         icon: [
             { url: "/favicon.ico", sizes: "any" },
-            { url: "/icon.png", type: "image/png", sizes: "192x192" },
+            // Icône PLEIN CADRE pour les moteurs de recherche (19/11/2026) :
+            // Google affiche l'icône dans un petit rond. public/icon.png a
+            // des coins arrondis transparents, le logo y apparaissait comme
+            // un carré rétréci au milieu d'un rond gris. favicon-192.png et
+            // favicon.ico ont un fond plein jusqu'aux bords, logo centré
+            // dans la zone qui survit à un recadrage en rond. icon.png reste
+            // l'icône de l'application (écran d'accueil).
+            { url: "/favicon-192.png", type: "image/png", sizes: "192x192" },
         ],
         apple: "/icon.png",
     },
diff --git a/public/demo.html b/public/demo.html
index 7fb7b7b..1905989 100644
--- a/public/demo.html
+++ b/public/demo.html
@@ -122,7 +122,6 @@
       <span class="video-play-label" data-i18n="play">Lire la vidéo</span>
     </button>
   </div>
-  <p class="note" data-i18n="note">Sans son — tout est écrit à l'écran.</p>
 
   <div class="points">
     <div class="point"><h3 data-i18n="p1t">Il trouve</h3><p data-i18n="p1b">Vous décrivez votre cible une fois. Aaron cherche les entreprises et les bons interlocuteurs.</p></div>
diff --git a/public/favicon-192.png b/public/favicon-192.png
new file mode 100644
index 0000000000000000000000000000000000000000..1f30c8c3c81ec9e9e49fee3cc22d37ca55b1d0a0
