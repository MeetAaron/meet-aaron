+var LOCALES = ['fr','en','de','it','es','pt','nl'];
+var LOCALE_LABELS = {fr:'Français',en:'English',de:'Deutsch',it:'Italiano',es:'Español',pt:'Português',nl:'Nederlands'};
+var LANG_KEY = 'aaron_locale';   // même clé que landing.html : un seul choix de langue pour tout le site
+var currentLocale = 'fr';
+
+function tr(k){ var d = I18N[currentLocale] || I18N.fr; return d[k] !== undefined ? d[k] : (I18N.fr[k] || ''); }
+function detectLocale(){
+  try { var s = localStorage.getItem(LANG_KEY); if (s && I18N[s]) return s; } catch(e){}
+  var langs = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language || 'fr'];
+  for (var i=0;i<langs.length;i++){ var c = String(langs[i]).slice(0,2).toLowerCase(); if (I18N[c]) return c; }
+  return 'en';
+}
+function applyLocale(loc){
+  currentLocale = I18N[loc] ? loc : 'fr';
+  document.getElementById('htmlRoot').setAttribute('lang', currentLocale);
+  var n = document.querySelectorAll('[data-i18n]');
+  for (var i=0;i<n.length;i++) n[i].textContent = tr(n[i].getAttribute('data-i18n'));
+  var h = document.querySelectorAll('[data-i18n-html]');
+  for (var j=0;j<h.length;j++) h[j].innerHTML = tr(h[j].getAttribute('data-i18n-html'));
+  document.title = tr('meta.title');
+  var p = document.getElementById('langPicker');
+  if (p) p.value = currentLocale;
+  try { localStorage.setItem(LANG_KEY, currentLocale); } catch(e){}
+}
+(function init(){
+  var p = document.getElementById('langPicker');
+  for (var i=0;i<LOCALES.length;i++){
+    var o = document.createElement('option');
+    o.value = LOCALES[i]; o.textContent = LOCALE_LABELS[LOCALES[i]];
+    p.appendChild(o);
+  }
+  p.addEventListener('change', function(){ applyLocale(p.value); });
+  applyLocale(detectLocale());
+
+  var facade = document.getElementById('videoFacade');
+  var frame = document.getElementById('videoFrame');
+  facade.addEventListener('click', function(){
