+<script>
+/* ───────────────────────────────────────────────────────────────────────────
+   QUELLE VIDÉO POUR QUEL PAYS (30/10/2026, décision Alex).
+
+   La vidéo n'est PAS choisie par la langue mais par le PAYS : le prix affiché
+   à l'écran est en euros dans la version France et en livres dans la version
+   Royaume-Uni. Un Belge francophone doit voir des euros, pas la version UK
+   parce qu'il parle français ni l'inverse.
+
+   AJOUTER UN PAYS plus tard = une seule ligne dans VIDEO_BY_COUNTRY, plus son
+   fuseau dans TZ_COUNTRY si le pays n'y est pas encore. Rien d'autre à
+   toucher. Quand la version USA existera, mettre DEFAULT_COUNTRY = 'US' :
+   c'est elle qui deviendra le repli de tous les pays non couverts (dollars).
+
+   DÉTECTION : fuseau horaire du navigateur, puis région de la langue
+   (fr-BE -> BE). Aucun appel réseau, aucune base de géolocalisation externe —
+   exigence CASA, la page ne doit contacter personne au chargement.
+   On peut forcer avec ?pays=FR pour tester.
+   ──────────────────────────────────────────────────────────────────────── */
+var VIDEO_BY_COUNTRY = {
+  FR: 'V-r0IvDzZO8',   // France — officielle 16:9, prix en euros
+  GB: 'VrIzWxGvlxs'    // Royaume-Uni — officielle 16:9, prix en livres
+  // US: '...',        // à ajouter : deviendra le repli par défaut
+};
+var DEFAULT_COUNTRY = 'GB';   // -> 'US' dès que la vidéo USA existe
+
+var TZ_COUNTRY = {
+  'Europe/Paris':'FR','Indian/Reunion':'FR','America/Martinique':'FR','America/Guadeloupe':'FR',
+  'Europe/London':'GB','Europe/Belfast':'GB',
+  'Europe/Brussels':'BE','Europe/Zurich':'CH','Europe/Luxembourg':'LU','Europe/Monaco':'MC',
+  'Europe/Berlin':'DE','Europe/Vienna':'AT','Europe/Rome':'IT','Europe/Madrid':'ES',
+  'Europe/Lisbon':'PT','Europe/Amsterdam':'NL','Europe/Dublin':'IE',
+  'America/New_York':'US','America/Chicago':'US','America/Denver':'US','America/Los_Angeles':'US',
+  'America/Phoenix':'US','America/Anchorage':'US','Pacific/Honolulu':'US',
+  'America/Toronto':'CA','America/Vancouver':'CA',
+  'Australia/Sydney':'AU','Australia/Melbourne':'AU','Australia/Brisbane':'AU','Australia/Perth':'AU'
+};
+
+function detectCountry(){
+  try {
+    var forced = new URLSearchParams(window.location.search).get('pays');
+    if (forced) return forced.toUpperCase();
+  } catch(e){}
+  try {
+    var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
+    if (tz && TZ_COUNTRY[tz]) return TZ_COUNTRY[tz];
+  } catch(e){}
+  try {
+    var langs = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language || ''];
+    for (var i=0;i<langs.length;i++){
+      var m = String(langs[i]).match(/^[a-z]{2}[-_]([A-Za-z]{2})$/);
+      if (m) return m[1].toUpperCase();
+    }
+  } catch(e){}
+  return DEFAULT_COUNTRY;
+}
+
+function pickVideoId(){
+  var country = detectCountry();
+  return VIDEO_BY_COUNTRY[country] || VIDEO_BY_COUNTRY[DEFAULT_COUNTRY];
+}
+
+(function initVideo(){
+  var facade = document.getElementById('videoFacade');
+  var frame  = document.getElementById('videoFrame');
+  if (!facade || !frame) return;
+  facade.addEventListener('click', function(){
+    var id = pickVideoId();
+    var iframe = document.createElement('iframe');
+    // nocookie + autoplay (geste utilisateur, donc autorisé) + rel=0 pour ne
+    // pas proposer les vidéos d'autres chaînes à la fin.
+    iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
+    iframe.title = 'Meet Aaron';
+    iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
+    iframe.setAttribute('allowfullscreen', '');
+    iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
+    frame.innerHTML = '';
+    frame.appendChild(iframe);
+  });
+})();
+</script>
