diff --git a/app/api/social/media/[...path]/route.ts b/app/api/social/media/[...path]/route.ts
new file mode 100644
index 0000000..8c02f85
--- /dev/null
+++ b/app/api/social/media/[...path]/route.ts
@@ -0,0 +1,33 @@
+// app/api/social/media/[...path]/route.ts
+//
+// AARON SOCIAL : sert une photo de post depuis meetaaron.app (21/11/2026).
+// TikTok (Content Posting API, PULL_FROM_URL) ne tire une image que d'un
+// domaine vérifié : le stockage reste privé, et c'est cette adresse qu'on
+// lui donne. Le chemin (3 identifiants aléatoires) est contrôlé strictement.
+
+import { NextRequest, NextResponse } from 'next/server';
+import { supabaseAdmin } from '@/lib/supabase-admin';
+import { SOCIAL_MEDIA_BUCKET, SOCIAL_MEDIA_PATH } from '@/lib/social-media';
+
+export const runtime = 'nodejs';
+
+const TYPES: Record<string, string> = { jpg: 'image/jpeg', png: 'image/png', webp: 'image/webp' };
+
+export async function GET(_request: NextRequest, { params }: { params: Promise<{ path: string[] }> }) {
+  const { path: parts } = await params;
+  const path = (parts || []).join('/');
+  if (!SOCIAL_MEDIA_PATH.test(path)) return new NextResponse('Not found', { status: 404 });
+
+  const { data, error } = await supabaseAdmin.storage.from(SOCIAL_MEDIA_BUCKET).download(path);
+  if (error || !data) return new NextResponse('Not found', { status: 404 });
+
+  const ext = path.split('.').pop()!.toLowerCase();
+  return new NextResponse(Buffer.from(await data.arrayBuffer()), {
+    status: 200,
+    headers: {
+      'Content-Type': TYPES[ext] || 'application/octet-stream',
+      'Cache-Control': 'public, max-age=31536000, immutable',
+      'X-Content-Type-Options': 'nosniff',
+    },
+  });
+}
diff --git a/app/api/social/posts/[id]/media/route.ts b/app/api/social/posts/[id]/media/route.ts
new file mode 100644
index 0000000..74cd48c
--- /dev/null
+++ b/app/api/social/posts/[id]/media/route.ts
@@ -0,0 +1,103 @@
+// app/api/social/posts/[id]/media/route.ts
+//
+// AARON SOCIAL : photos d'un post (21/11/2026).
+// POST   multipart « file » (JPEG, PNG ou WebP, 4 Mo max — l'écran réduit la
+//        photo avant l'envoi) -> ajoutée au post ;
+// DELETE ?path=… -> retirée du post et du stockage.
+// Réservé pour l'instant au compte aaron@meetaaron.app (lib/social-access.js).
+
+import { randomUUID } from 'crypto';
+import { NextRequest, NextResponse } from 'next/server';
+import { supabaseAdmin } from '@/lib/supabase-admin';
+import { getAuthedUser, unauthorizedResponse } from '@/lib/auth-helpers';
+import { socialPreviewAllowed } from '@/lib/social-access';
+import {
+  SOCIAL_MEDIA_BUCKET,
+  SOCIAL_MEDIA_MAX_BYTES,
+  SOCIAL_MEDIA_MAX_PER_POST,
+  SOCIAL_MEDIA_TYPES,
+  cleanMediaList,
+  postIsReady,
+} from '@/lib/social-media';
+
+export const runtime = 'nodejs';
+
+const SELECT = 'id, week, slot, category, subject, material_needed, material_hint, content, status, media, review_text, company_id';
+
+async function loadPost(request: NextRequest, id: string) {
+  const authedUser = await getAuthedUser(request);
+  if (!authedUser) return { error: unauthorizedResponse() };
+  if (!socialPreviewAllowed(authedUser.email) || !authedUser.company_id) {
+    return { error: NextResponse.json({ error: 'not_found' }, { status: 404 }) };
+  }
+  const { data: post, error } = await supabaseAdmin.from('social_posts').select(SELECT).eq('id', id).maybeSingle();
+  if (error?.code === '42703') return { error: NextResponse.json({ error: 'migration_missing' }, { status: 409 }) };
+  if (!post || (post as any).company_id !== authedUser.company_id) {
+    return { error: NextResponse.json({ error: 'not_found' }, { status: 404 }) };
+  }
+  return { post: post as any };
+}
+
+async function saveMedia(post: any, media: any[]) {
+  const next = { ...post, media };
+  const update: any = { media, updated_at: new Date().toISOString() };
+  if (post.status !== 'publie' && post.status !== 'retire') update.status = postIsReady(next) ? 'pret' : 'brouillon';
+  const { data, error } = await supabaseAdmin.from('social_posts').update(update).eq('id', post.id).select(SELECT).single();
+  if (error) throw error;
+  const { company_id, ...rest } = data as any;
+  return rest;
+}
+
+export async function POST(request: NextRequest, { params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  const loaded = await loadPost(request, id);
+  if ('error' in loaded) return loaded.error;
+  const post = loaded.post;
+
+  const form = await request.formData().catch(() => null);
+  const file = form?.get('file') as File | null;
+  if (!file) return NextResponse.json({ error: 'file_missing' }, { status: 400 });
+  const ext = SOCIAL_MEDIA_TYPES[file.type];
+  if (!ext) return NextResponse.json({ error: 'bad_type' }, { status: 400 });
+  if (file.size > SOCIAL_MEDIA_MAX_BYTES) return NextResponse.json({ error: 'too_big' }, { status: 400 });
+
+  const current = cleanMediaList(post.media);
+  if (current.length >= SOCIAL_MEDIA_MAX_PER_POST) return NextResponse.json({ error: 'too_many' }, { status: 400 });
+
+  const path = `${post.company_id}/${post.id}/${randomUUID()}.${ext}`;
+  const { error: upErr } = await supabaseAdmin.storage
+    .from(SOCIAL_MEDIA_BUCKET)
+    .upload(path, Buffer.from(await file.arrayBuffer()), { contentType: file.type, upsert: false });
+  if (upErr) {
+    console.error('[social] envoi de la photo :', upErr.message);
+    return NextResponse.json({ error: 'upload_failed' }, { status: 500 });
+  }
+
+  try {
+    const saved = await saveMedia(post, [...current, { path, added_at: new Date().toISOString() }]);
+    return NextResponse.json({ post: saved });
+  } catch (err: any) {
+    await supabaseAdmin.storage.from(SOCIAL_MEDIA_BUCKET).remove([path]).catch(() => null);
+    console.error('[social] enregistrement de la photo :', err?.message || err);
+    return NextResponse.json({ error: 'server_error' }, { status: 500 });
+  }
+}
+
+export async function DELETE(request: NextRequest, { params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  const loaded = await loadPost(request, id);
+  if ('error' in loaded) return loaded.error;
+  const post = loaded.post;
+  const path = request.nextUrl.searchParams.get('path') || '';
+  const current = cleanMediaList(post.media);
+  if (!current.some((m) => m.path === path)) return NextResponse.json({ error: 'not_found' }, { status: 404 });
+
+  try {
+    const saved = await saveMedia(post, current.filter((m) => m.path !== path));
+    await supabaseAdmin.storage.from(SOCIAL_MEDIA_BUCKET).remove([path]).catch(() => null);
+    return NextResponse.json({ post: saved });
+  } catch (err: any) {
+    console.error('[social] retrait de la photo :', err?.message || err);
+    return NextResponse.json({ error: 'server_error' }, { status: 500 });
+  }
+}
diff --git a/app/api/social/posts/[id]/route.ts b/app/api/social/posts/[id]/route.ts
new file mode 100644
index 0000000..fb2ee49
--- /dev/null
+++ b/app/api/social/posts/[id]/route.ts
@@ -0,0 +1,75 @@
+// app/api/social/posts/[id]/route.ts
+//
+// AARON SOCIAL : modifier un post (21/11/2026).
+// PATCH { content?, review_text? }
+//   - content : le texte d'un ou plusieurs réseaux, retouché par le client ;
+//   - review_text : l'avis client recopié, pour un post « client satisfait ».
+// Le statut suit : « pret » quand ce que le post demandait est fourni.
+//
+// Réservé pour l'instant au compte aaron@meetaaron.app (lib/social-access.js).
+
+import { NextRequest, NextResponse } from 'next/server';
+import { supabaseAdmin } from '@/lib/supabase-admin';
+import { getAuthedUser, unauthorizedResponse } from '@/lib/auth-helpers';
+import { socialPreviewAllowed } from '@/lib/social-access';
+import { postIsReady } from '@/lib/social-media';
+import { readJsonBody } from '@/lib/http';
+
+export const runtime = 'nodejs';
+
+const str = (v: any, max: number) => (typeof v === 'string' ? v.replace(/\r\n/g, '\n').trim().slice(0, max) : '');
+const list = (v: any, count: number, max: number) =>
+  Array.isArray(v) ? v.map((x) => str(x, max)).filter(Boolean).slice(0, count) : [];
+
+// On ne garde que la forme attendue : rien d'autre n'entre dans content.
+function mergeContent(current: any, incoming: any) {
+  const c = current && typeof current === 'object' ? current : {};
+  const n = incoming && typeof incoming === 'object' ? incoming : {};
+  const out: any = { ...c };
+  if (n.instagram) out.instagram = { slides: list(n.instagram.slides, 5, 220), caption: str(n.instagram.caption, 1500) };
+  if (n.facebook) out.facebook = { text: str(n.facebook.text, 2000) };
+  if (n.linkedin) out.linkedin = { slides: list(n.linkedin.slides, 5, 220), text: str(n.linkedin.text, 2000) };
+  if (n.tiktok) out.tiktok = { scenes: list(n.tiktok.scenes, 5, 120), caption: str(n.tiktok.caption, 300) };
+  return out;
+}
+
+export async function PATCH(request: NextRequest, { params }: { params: Promise<{ id: string }> }) {
+  const authedUser = await getAuthedUser(request);
+  if (!authedUser) return unauthorizedResponse();
+  if (!socialPreviewAllowed(authedUser.email) || !authedUser.company_id) {
+    return NextResponse.json({ error: 'not_found' }, { status: 404 });
+  }
+  const { id } = await params;
+  const body = await readJsonBody(request).catch(() => ({}));
+
+  const { data: post } = await supabaseAdmin
+    .from('social_posts')
+    .select('id, company_id, content, material_needed, media, review_text, status')
+    .eq('id', id)
+    .maybeSingle();
+  if (!post || (post as any).company_id !== authedUser.company_id) {
+    return NextResponse.json({ error: 'not_found' }, { status: 404 });
+  }
+
+  const update: any = { updated_at: new Date().toISOString() };
+  if (body?.content) update.content = mergeContent((post as any).content, body.content);
+  if (typeof body?.review_text === 'string') update.review_text = str(body.review_text, 2000) || null;
+
+  const next = { ...(post as any), ...update };
+  if ((post as any).status !== 'publie' && (post as any).status !== 'retire') {
+    update.status = postIsReady(next) ? 'pret' : 'brouillon';
+  }
+
+  const { data: saved, error } = await supabaseAdmin
+    .from('social_posts')
+    .update(update)
+    .eq('id', id)
+    .select('id, week, slot, category, subject, material_needed, material_hint, content, status, media, review_text')
+    .single();
+  if (error) {
+    if (error.code === '42703') return NextResponse.json({ error: 'migration_missing' }, { status: 409 });
+    console.error('[social] modification du post :', error.code || '', error.message);
+    return NextResponse.json({ error: 'server_error' }, { status: 500 });
+  }
+  return NextResponse.json({ post: saved });
+}
