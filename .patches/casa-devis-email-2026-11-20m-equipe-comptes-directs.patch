                     </span>
                   </div>
                   <span className="rank-score">{m.clients_gagnes || 0}</span>
@@ -831,6 +830,23 @@ export default function TeamPage() {
                 <tbody>
                   {seats.map((s) => {
                     const busy = seatActionBusy === s.id;
+                    if (s.direct) {
+                      return (
+                        <tr key={s.id}>
