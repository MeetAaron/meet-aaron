+  // elle est voulue (voir isAppEntryAllowed).
+  if (isAppEntryAllowed()) return;
   let next: string | null = null;
   try { next = window.localStorage.getItem(POST_LOGIN_NEXT_KEY); } catch (err) {}
   try {
