# ============================================================
# Variables d'environnement à ajouter dans Vercel
# (Project Settings > Environment Variables)
# ============================================================

# App
APP_URL=https://meetaaron.app

# Supabase
SUPABASE_URL=https://ftssujspaoliheynbhpq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # depuis Supabase > Settings > API Keys (secret !)

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (une fois le compte Azure débloqué)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Chiffrement des tokens OAuth stockés en base
# Génère avec : openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Anthropic (le cerveau d'Aaron)
ANTHROPIC_API_KEY=

# Sécurise les routes /api/cron/* (génère une chaîne aléatoire quelconque)
CRON_SECRET=

# Notifications push web (protocole Web Push standard, aucun service tiers).
# Paire de clés VAPID générée une fois pour toutes pour ce projet — NE PAS
# régénérer sans redébrancher tous les abonnements existants (ils deviendraient
# invalides). NEXT_PUBLIC_VAPID_PUBLIC_KEY doit avoir EXACTEMENT la même valeur
# que VAPID_PUBLIC_KEY (le préfixe NEXT_PUBLIC_ l'expose au navigateur, ce qui
# est normal : c'est une clé publique).
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aaron@meetaaron.app

# Emails "système" (confirmation de compte, etc.) — id de la ligne "users" dont
# le compte Google est déjà connecté (table oauth_connections), utilisé en
# attendant qu'aaron@meetaaron.app ait sa propre connexion OAuth dans l'app.
# Pas un secret : juste un identifiant technique interne.
SYSTEM_EMAIL_SENDER_USER_ID=

# Signature électronique — Youtrust (ex-Yousign, voir lib/youtrust.ts).
# YOUTRUST_API_KEY : clé API récupérée sur le tableau de bord Youtrust
#   (commencer par une clé "sandbox" gratuite pour tester, voir
#   developers.youtrust.com/docs/environments-new — une clé "production"
#   nécessite un abonnement payant).
# YOUTRUST_API_BASE : optionnel, à définir UNIQUEMENT en production, sinon
#   l'app reste en sandbox par défaut (aucun email réel envoyé au prospect) :
#   https://api.yousign.app/v3
# YOUTRUST_WEBHOOK_SECRET : chaîne aléatoire de ton choix (ex: openssl rand
#   -hex 16) — la même valeur doit être ajoutée à l'URL du webhook configuré
#   dans le tableau de bord Youtrust (Paramètres > Webhooks) sur les
#   événements "signature_request.done" et "signature_request.declined) :
#   https://meetaaron.app/api/webhooks/youtrust?secret=<cette-valeur>
YOUTRUST_API_KEY=
YOUTRUST_API_BASE=
YOUTRUST_WEBHOOK_SECRET=
