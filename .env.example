# ============================================================
# Variables d'environnement à ajouter dans Vercel
# (Project Settings > Environment Variables)
# ============================================================

# App
APP_URL=https://meetaaron.app

# Supabase
SUPABASE_URL=https://ftssujspaoliheynbhpq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # depuis Supabase > Settings > API Keys (secret !)

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (une fois le compte Azure débloqué)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Chiffrement des tokens OAuth stockés en base
# Génère avec : openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Anthropic (le cerveau d'Aaron)
ANTHROPIC_API_KEY=

# Sécurise les routes /api/cron/* (génère une chaîne aléatoire quelconque)
CRON_SECRET=
